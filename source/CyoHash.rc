IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Hash File(s)...",                 IDC_MENU_HASHFILE
        MENUITEM SEPARATOR
        MENUITEM "Export Hash(es)...",              IDC_MENU_EXPORTHASHES
        MENUITEM "Export Forensic &PDF...",         IDC_MENU_EXPORT_FORENSIC_PDF
        MENUITEM SEPARATOR
        MENUITEM "Clear &Selected",                 IDC_MENU_CLEAR
        MENUITEM "Clear &All",                      IDC_MENU_CLEARALL
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                           IDCANCEL
    END
    POPUP "&Hash"
    BEGIN
        MENUITEM "&Copy Hash",                      IDC_MENU_COPYHASH
        MENUITEM "Select &Matching Hashes",         IDC_MENU_SELECT_MATCHING_HASHES
        MENUITEM "&Recalculate",                    IDC_MENU_RECALCULATE
        MENUITEM SEPARATOR
        MENUITEM "&Pause",                          IDC_MENU_PAUSE
        MENUITEM "&Resume",                         IDC_MENU_RESUME
        MENUITEM "&Cancel",                         IDC_MENU_CANCEL
    END
    POPUP "&View"
    BEGIN
        POPUP "&Sort by"
        BEGIN
            MENUITEM "&Unsorted",                   IDC_MENU_UNSORTED
            MENUITEM "&File",                       IDC_MENU_SORTBY_FILE
            MENUITEM "&Algorithm",                  IDC_MENU_SORTBY_ALGORITHM
            MENUITEM "&Hash",                       IDC_MENU_SORTBY_HASH
        END
        MENUITEM "Reset Column &Widths",            IDC_MENU_RESET_COLUMNS
        MENUITEM SEPARATOR
        MENUITEM "Always on &Top",                  IDC_MENU_ALWAYS_ON_TOP
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About CyoHash...",               IDC_MENU_ABOUT
    END
END

