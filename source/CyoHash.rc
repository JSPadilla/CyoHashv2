IDD_CYOHASH2 DIALOGEX 0, 0, 400, 100
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "CyoHash v2.6.0"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "",IDC_LIST,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_TABSTOP,6,6,388,88
END

IDD_CYOHASH DIALOGEX 0, 0, 320, 146
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CyoHash v2.6.0"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "IDC_FILE",IDC_FILE,6,6,308,12,SS_CENTERIMAGE | SS_PATHELLIPSIS
