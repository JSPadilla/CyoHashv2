    RTEXT           "Paste:",IDC_RESULT,6,108,48,12,SS_CENTERIMAGE
    PUSHBUTTON      "Export PDF...",IDC_EXPORT_PDF,6,128,70,14
    GROUPBOX        "",IDC_STATIC,6,24,307,60
    CTEXT           "IDC_HASHNAME",IDC_HASHNAME,12,36,294,12,SS_CENTERIMAGE
